# 줄바꿈 고정 — 크로스 플랫폼 빌드 이식성 보장
# (전체 재정규화는 하지 않고, 깨지면 곤란한 파일만 명시)

# Gradle Wrapper: Unix 스크립트는 반드시 LF(아니면 Linux/Mac 에서 실행 깨짐)
gradlew        text eol=lf
*.sh           text eol=lf

# Windows 배치 스크립트는 CRLF
gradlew.bat    text eol=crlf
*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf

# 바이너리 — 줄바꿈/머지 변환 금지
*.jar          binary
*.png          binary
