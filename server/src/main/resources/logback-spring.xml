<?xml version="1.0" encoding="UTF-8"?>
<!--
  로깅 정책.
  - 기본(개발): 사람이 읽기 좋은 콘솔 + [requestId] 상관관계.
  - prod 프로파일(SPRING_PROFILES_ACTIVE=prod): JSON 한 줄 로그(ELK/Loki/Datadog 등 수집 친화).
  요청 ID 는 RequestIdFilter 가 MDC(requestId)에 심는다.
-->
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="chartsdk-server"/>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%X{requestId:-}] %logger{32} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <customFields>{"app":"${appName}"}</customFields>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
