# server meta DB connection. Local Docker defaults.
DATABASE_URL=jdbc:postgresql://localhost:5433/chartsol
DATABASE_USER=postgres
DATABASE_PASSWORD=0218

# Production: use a DDL-only migration login here and chartsdk_app above.
# Local development should omit these to reuse DATABASE_*.
FLYWAY_ENABLED=true
# SPRING_FLYWAY_URL=jdbc:postgresql://db.internal:5432/chartsol
# SPRING_FLYWAY_USER=chartsdk_migrator
# SPRING_FLYWAY_PASSWORD=

# Replace in production. Used by datasource password encryption.
DATASOURCE_ENC_KEY=
# Transition only: migrate first, verify zero legacy rows, then set allow=false and migrate=false.
DATASOURCE_PASSWORD_ALLOW_LEGACY_PLAINTEXT=true
DATASOURCE_PASSWORD_MIGRATE_LEGACY_ON_STARTUP=false

# Customer datasource pool registry (soft cap; active borrowers are never force-closed).
DATASOURCE_POOL_REGISTRY_MAX=128
DATASOURCE_POOL_IDLE_TTL_SECONDS=1800
DATASOURCE_POOL_CLEANUP_INTERVAL_SECONDS=60
# Retry failed sample/chart cache deletion while that datasource cache remains fail-closed.
DATASOURCE_CACHE_INVALIDATION_RETRY_MS=30000

# JVM-local customer query admission budget. Divide a total DB budget by fixed replica count.
QUERY_MAX_CONCURRENT=24
QUERY_MAX_CONCURRENT_PER_DATASOURCE=4
QUERY_MAX_CONCURRENT_FEDERATED=2
QUERY_ADMISSION_WAIT_MILLIS=2000

# Query deadlines by execution purpose. Fast metadata stays strict; heavy chart work gets more time.
QUERY_TIMEOUT_PREVIEW_SECONDS=10
QUERY_TIMEOUT_CATALOG_SECONDS=10
QUERY_TIMEOUT_EXPLAIN_SECONDS=10
QUERY_TIMEOUT_CHART_SECONDS=30
QUERY_TIMEOUT_SAMPLE_SECONDS=30
QUERY_TIMEOUT_FEDERATION_SECONDS=30

# Observe chartsdk.chart.update.version_missing at zero before changing this to true.
CHART_REQUIRE_UPDATE_VERSION=false

# Keep actuator details hidden until its endpoint is isolated and authenticated.
MANAGEMENT_HEALTH_SHOW_DETAILS=never

# Replace in production. JWT is legacy management data; sdk.js uses the chart-bound embed key below.
CHARTSDK_EMBED_JWT_SECRET=dev-chartsol-embed-secret-change-me
CHARTSDK_EMBED_KEY_SECRET=dev-chartsol-embed-key-secret-change-me

# admin -> Spring API. Set ENABLE_MSW=false when using the real backend.
NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_ENABLE_MSW=false
